# Copy to wrangler.toml and fill in the IDs. wrangler.toml is gitignored so your
# account details stay out of the public repo.
name = "tattle"
main = "src/index.js"
compatibility_date = "2026-10-01"
workers_dev = true

[triggers]
crons = ["17 * * * *"]   # hourly missed-check-in sweep

[vars]
STALE_HOURS = "36"

[[r2_buckets]]
binding = "REPORTS"
bucket_name = "tattle-reports"

[[kv_namespaces]]
binding = "STATE"
id = "<kv namespace id>"

# Secrets (wrangler secret put NAME): HOST_TOKENS, READ_TOKEN, CANARY_KEY, NTFY_URL

# Serve the collector and installer as text, straight from the repo.
[[rules]]
type = "Text"
globs = ["**/tattle-collect", "**/*.sh"]
fallthrough = true

# Required: strict per-host admission. KV remains a read/silence-sweep view.
# Deploy this migration with the binding before accepting reports/provisioning.
[[durable_objects.bindings]]
name = "HOST_GATE"
class_name = "HostGate"

[[migrations]]
tag = "v1-host-gate"
new_sqlite_classes = ["HostGate"]
