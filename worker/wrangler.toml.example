# Copy to wrangler.toml and fill in the IDs. wrangler.toml is gitignored so your
# account details stay out of the public repo.
name = "tattle"
main = "src/index.js"
compatibility_date = "2026-10-01"
workers_dev = true

[triggers]
crons = ["17 * * * *"]   # hourly missed-check-in sweep

[vars]
STALE_HOURS = "36"
# Email alerts. The From address must be on a domain that uses Cloudflare Email
# Routing in this account, and the To address must be a verified destination
# address there. If you leave these out, set NTFY_URL so alerts go to ntfy.
ALERT_EMAIL_FROM = "tattle@<your domain>"
ALERT_EMAIL_TO = "<you>@example.com"

[[send_email]]
name = "EMAIL"
destination_address = "<you>@example.com"

[[r2_buckets]]
binding = "REPORTS"
bucket_name = "tattle-reports"

[[kv_namespaces]]
binding = "STATE"
id = "<kv namespace id>"

# Secrets (wrangler secret put NAME): HOST_TOKENS, READ_TOKEN, CANARY_KEY.
# Optional: NTFY_URL, NTFY_TOKEN, HEARTBEAT_URL, CANARY_EMAIL.

# Serve the collector and installer as text, straight from the repo.
[[rules]]
type = "Text"
globs = ["**/tattle-collect", "**/*.sh"]
fallthrough = true
